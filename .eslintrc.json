{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "rules": {
    "no-constant-condition": "warn",
    "no-unreachable": "warn",
    "no-redeclare": "warn",
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-empty": "warn"
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "extends": "eslint:recommended"
}

